{
  "name": "pixiv-downloader",
  "description": "A Chrome extension to download images from Pixiv",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "format": "prettier --write src/",
    "lint": "eslint src/ --fix",
    "check:compile": "vue-tsc --noEmit",
    "check:format": "prettier --check src/",
    "check:lint": "eslint src/",
    "test": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "@webext-core/proxy-service": "^3.0.2",
    "vue": "^3.5.42",
    "vuetify": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-vue": "^1.0.3",
    "chrome-types": "^0.1.443",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
